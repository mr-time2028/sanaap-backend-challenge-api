# Copy this file to .env and adjust values. NEVER commit .env.
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1      # change this on prod to 0.0.0.0

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Email ---
DEFAULT_FROM_EMAIL=noreply@dms.local

# --- Database ---
# Dev default: PostgreSQL from docker compose ("docker compose -f docker-compose.dev.yml up -d").
# Zero-setup fallback: DB_ENGINE=sqlite3 (ignore the DB_* values).
DB_ENGINE=postgresql
DB_NAME=dms
DB_USER=dms
DB_PASSWORD=dms
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Document storage ---
STORAGE_BACKEND=minio
LOCAL_STORAGE_PATH=var/files
# --- MinIO ---
MINIO_BROWSER=on
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documents

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
REDIS_PORT=6379

# --- Nginx ---
NGINX_PORT=8080

# flip to True only behind real HTTPS (see README — Deploying to a server)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost:8080    # change this on prod to 0.0.0.0
